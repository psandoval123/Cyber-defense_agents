# Reglas locales del Laboratorio 1 — detección de reconocimiento.
#
# Objetivo: detectar las técnicas de reconocimiento del adversario emulado y
# dejar en el mensaje la técnica MITRE ATT&CK, para que el agente la correlacione.
# $HOME_NET incluye 172.16.0.0/12 por defecto, así que la víctima (172.28.0.10)
# queda cubierta.
#
# Formato del msg: "LAB-RECON <descripción> [<Txxxx>]"

# --- T1046: escaneo de puertos / servicios (muchos SYN en poco tiempo) ---
alert tcp any any -> $HOME_NET any ( \
    msg:"LAB-RECON Escaneo de puertos TCP (SYN a multiples puertos) [T1046]"; \
    flow:to_server; flags:S,12; \
    detection_filter: track by_src, count 15, seconds 10; \
    classtype:attempted-recon; sid:1000001; rev:1; metadata: attack_target Server; )

# --- T1046: nmap -sV (sondas de versión con firma reconocible) ---
alert http any any -> $HOME_NET any ( \
    msg:"LAB-RECON Fingerprinting con Nmap (NSE/service scan) [T1046]"; \
    flow:to_server; http.user_agent; content:"Nmap"; nocase; \
    classtype:attempted-recon; sid:1000002; rev:1; )

# --- T1592.002: fingerprinting de tecnologías web (WhatWeb) ---
alert http any any -> $HOME_NET any ( \
    msg:"LAB-RECON Fingerprinting de tecnologias web (WhatWeb) [T1592.002]"; \
    flow:to_server; http.user_agent; content:"WhatWeb"; nocase; \
    classtype:attempted-recon; sid:1000003; rev:1; )

# --- T1595.003: enumeración de rutas/directorios web (gobuster/dirb) ---
alert http any any -> $HOME_NET any ( \
    msg:"LAB-RECON Enumeracion de rutas web (gobuster/dirb) [T1595.003]"; \
    flow:to_server; http.user_agent; content:"gobuster"; nocase; \
    classtype:web-application-attack; sid:1000004; rev:1; )

# --- T1595.003: enumeración web por volumen de 404 (fuerza bruta de rutas) ---
alert http $HOME_NET any -> any any ( \
    msg:"LAB-RECON Alto volumen de 404 (posible fuerza bruta de rutas) [T1595.003]"; \
    flow:to_client; http.stat_code; content:"404"; \
    detection_filter: track by_dst, count 20, seconds 15; \
    classtype:web-application-attack; sid:1000005; rev:1; )
