# --- Configuración del agente de detección (Lab 1) ---
# Este laboratorio usa un LLM LOCAL vía Ollama. No requiere clave de API.

# Endpoint de Ollama.
#   - Por defecto apunta al servicio `ollama` de este docker-compose.
#   - Si ya corres Ollama en tu máquina (host), comenta la línea de arriba y usa:
#     OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_HOST=http://ollama:11434

# Modelo local a usar. Debe estar descargado en Ollama (ver README, paso 4).
# Ligero y bueno con JSON. Alternativas: qwen2.5:3b, llama3.1:8b, mistral:7b.
LAB_MODELO=llama3.2:3b

# Máximo de iteraciones del ciclo ReAct del agente (evita bucles infinitos).
LAB_MAX_ITERACIONES=12

# Temperatura del modelo (0 = más determinista, recomendado para reproducibilidad).
LAB_TEMPERATURA=0

# Objetivo monitorizado (la víctima en la red interna). Solo informativo para el agente.
LAB_OBJETIVO=victima
