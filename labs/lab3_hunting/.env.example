# --- Configuración del Lab 3 (hunting) ---
# LLM y embeddings LOCALES vía Ollama. Sin clave de API.

OLLAMA_HOST=http://ollama:11434

# Modelo de razonamiento del agente.
LAB_MODELO=llama3.2:3b
# Modelo de embeddings para el RAG.
LAB_EMBED_MODEL=nomic-embed-text

# Temperatura (0 = determinista, recomendado para reproducibilidad).
LAB_TEMPERATURA=0
# Máximo de iteraciones del grafo del agente (ciclo de refinamiento).
LAB_MAX_ITERACIONES=6
