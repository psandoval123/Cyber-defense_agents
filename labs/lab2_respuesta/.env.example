# --- Configuración del agente de respuesta (Lab 2) ---
# Reutiliza el LLM local vía Ollama (el mismo modelo del Lab 1). Sin clave de API.

# Endpoint de Ollama (servicio del compose; o host.docker.internal si usas el del host).
OLLAMA_HOST=http://ollama:11434

# Modelo local (debe estar descargado: docker compose exec ollama ollama pull ...).
LAB_MODELO=llama3.2:3b

# Máximo de iteraciones del ciclo ReAct del agente.
LAB_MAX_ITERACIONES=12

# Temperatura (0 = determinista, recomendado para reproducibilidad).
LAB_TEMPERATURA=0

# Host monitorizado (la víctima), solo informativo para el agente.
LAB_OBJETIVO=victima

# --- Aprobación humana (human-in-the-loop) ---
# La arquitectura exige intervención manual antes de acciones con impacto.
#   true  = el agente pide confirmación por teclado antes de bloquear (demo).
#   false = aprobación automática, para corridas de métricas desatendidas.
LAB_AUTO_APROBAR=false
